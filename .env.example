# ── Database (Supabase → Project Settings → Database → Connection string) ──
# DATABASE_URL = "Transaction" pooler (port 6543) for the app runtime.
# DIRECT_URL   = "Session" pooler / direct (port 5432) for prisma migrate.
DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ──
# Generate with: npx auth secret
AUTH_SECRET="generate-with-npx-auth-secret"
# Google OAuth 2.0 Web client (Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only verified Google accounts on this domain can sign in (server-enforced).
ALLOWED_DOMAIN="gteceducation.com"
# REQUIRED IN PRODUCTION: comma-separated emails that get the MANAGER role.
# If empty, everyone is an EMPLOYEE and nobody can access /manager.
MANAGER_EMAILS=""

# ── Temp login (development/testing ONLY) ──
# The temp provider is hard-disabled when NODE_ENV=production regardless of
# this flag, but set it to "false" in production anyway.
ALLOW_TEMP_LOGIN="true"
TEMP_LOGIN_USER="tester"
TEMP_LOGIN_PASSWORD="changeme"
TEMP_LOGIN_ROLE="MANAGER"
# Second temp account for testing the employee flow (same production gating).
TEMP_STAFF_USER="staff"
TEMP_STAFF_PASSWORD="staffpass"
